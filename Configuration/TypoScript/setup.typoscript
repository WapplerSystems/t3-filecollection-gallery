plugin.tx_filecollectiongallery {
  view {
    templateRootPaths {
      0 = EXT:filecollection_gallery/Resources/Private/Templates/
      10 = {$plugin.tx_filecollectiongallery.view.templateRootPath ?? $filecollectiongallery.view.templateRootPath}
    }

    partialRootPaths {
      0 = EXT:filecollection_gallery/Resources/Private/Partials/
      5 = EXT:fluid_styled_content/Resources/Private/Partials/
      10 = {$plugin.tx_filecollectiongallery.view.partialRootPath ?? $filecollectiongallery.view.partialRootPath}
    }

    layoutRootPaths {
      0 = EXT:filecollection_gallery/Resources/Private/Layouts/
      10 = {$plugin.tx_filecollectiongallery.view.layoutRootPath ?? $filecollectiongallery.view.layoutRootPath}
    }

  }

  settings {

    media < lib.contentElement.settings.media

    mobile {
      image {
        maxRenderedWidth = {$plugin.tx_filecollectiongallery.settings.mobile.image.maxRenderedWidth ?? $filecollectiongallery.mobile.image.maxRenderedWidth}
        maxViewedWidth = {$plugin.tx_filecollectiongallery.settings.mobile.image.maxViewedWidth ?? $filecollectiongallery.mobile.image.maxViewedWidth}
      }
    }

    desktop {
      preview {
        image {
          renderedWidth = {$plugin.tx_filecollectiongallery.settings.desktop.preview.image.renderedWidth ?? $filecollectiongallery.desktop.preview.image.renderedWidth}
          maxViewedWidth = {$plugin.tx_filecollectiongallery.settings.desktop.preview.image.maxViewedWidth ?? $filecollectiongallery.desktop.preview.image.maxViewedWidth}
          renderedHeight = {$plugin.tx_filecollectiongallery.settings.desktop.preview.image.renderedHeight ?? $filecollectiongallery.desktop.preview.image.renderedHeight}
        }
      }
    }

    downloadButton = {$plugin.tx_filecollectiongallery.settings.downloadButton ?? $filecollectiongallery.downloadButton}

    lightbox {
      maxWidth = {$plugin.tx_filecollectiongallery.settings.lightbox.maxWidth  ?? $filecollectiongallery.lightbox.maxWidth}
      maxHeight = {$plugin.tx_filecollectiongallery.settings.lightbox.maxHeight  ?? $filecollectiongallery.lightbox.maxHeight}
    }

  }
}

