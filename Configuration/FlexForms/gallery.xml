<T3DataStructure>
    <meta type="array">
        <langDisable>1</langDisable>
    </meta>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>
                    LLL:EXT:filecollection_gallery/Resources/Private/Language/locallang_be.xlf:flexforms_tab.settings
                </sheetTitle>
                <type>array</type>
                <el>
                    <settings.inlineFileCollection>
                        <label>
                            LLL:EXT:filecollection_gallery/Resources/Private/Language/locallang_be.xlf:flexforms_general.filecollection
                        </label>
                        <config>
                            <type>inline</type>
                            <foreign_table>sys_file_collection</foreign_table>
                            <size>3</size>
                        </config>
                    </settings.inlineFileCollection>

                    <settings.desktop.columns>
                        <label>Number of columns (empty = global default)</label>
                        <config>
                            <type>select</type>
                            <renderType>selectSingle</renderType>
                            <items>
                                <numIndex index="0">
                                    <label>Global default (3)</label>
                                    <value></value>
                                </numIndex>
                                <numIndex index="1">
                                    <label>1 column</label>
                                    <value>1</value>
                                </numIndex>
                                <numIndex index="2">
                                    <label>2 columns</label>
                                    <value>2</value>
                                </numIndex>
                                <numIndex index="3">
                                    <label>3 columns</label>
                                    <value>3</value>
                                </numIndex>
                            </items>
                        </config>
                    </settings.desktop.columns>

                    <settings.fileCollection>
                        <exclude>1</exclude>
                        <label>
                            LLL:EXT:filecollection_gallery/Resources/Private/Language/locallang_be.xlf:flexforms_general.filecollection
                        </label>
                        <config>
                            <type>group</type>
                            <internal_type>db</internal_type>
                            <allowed>sys_file_collection</allowed>
                            <size>3</size>
                            <maxitems>50</maxitems>
                            <minitems>0</minitems>
                            <show_thumbs>1</show_thumbs>
                            <wizards>
                                <suggest>
                                    <type>suggest</type>
                                </suggest>
                            </wizards>
                        </config>
                    </settings.fileCollection>
                </el>
            </ROOT>
        </sDEF>

    </sheets>
</T3DataStructure>
